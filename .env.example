# ============================================================================
# Medix — environment template. Copy to `.env` and fill in real values.
#   copy .env.example .env      (Windows)
#   cp   .env.example .env      (macOS / Linux)
#
# `.env` is git-ignored. NEVER commit real credentials.
# This file must only ever contain placeholders.
# ============================================================================

# ---------------------------------------------------------------------------
# CLIENT-SAFE (browser) — forwarded to the bundle by the allowlist in
# vite.config.ts as import.meta.env.VITE_SUPABASE_URL / VITE_SUPABASE_PUBLISHABLE_KEY.
# The publishable key is designed to be public; every table is still protected
# by Row Level Security.
# ---------------------------------------------------------------------------
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_REPLACE_ME"

# ---------------------------------------------------------------------------
# SERVER-SIDE ONLY — never exposed to the browser.
#
# SUPABASE_SECRET_KEY bypasses Row Level Security entirely. Treat it like a
# root password. Used only by scripts/ (migrations, admin bootstrap, tests).
#   - do NOT prefix with VITE_
#   - do NOT commit
#   - do NOT log
# ---------------------------------------------------------------------------
SUPABASE_SECRET_KEY="sb_secret_REPLACE_ME"

# JWKS endpoint used to verify Supabase-issued JWTs signature-side.
SUPABASE_JWKS_URL="https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json"

# Direct PostgreSQL connection, used by `npm run db:migrate`.
# Contains the database password — server-side only.
# Special characters in the password must be percent-encoded (@ -> %40).
DATABASE_URL="postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"
